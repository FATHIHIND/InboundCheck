# =====================================================================
# InboundCheck Unified Workspace Environment Configuration
# =====================================================================

# ---------------------------------------------------------------------
# Backend Core Settings (FastAPI - http://localhost:8000)
# ---------------------------------------------------------------------
PROJECT_NAME="InboundCheck API Engine"
ENVIRONMENT="development"
API_V1_STR="/api/v1"
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
FRONTEND_URL="http://localhost:3000"

# ---------------------------------------------------------------------
# Supabase Configuration (Required for persistence and authentication)
# ---------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here
# Server-only: bypasses RLS for administrative operations (NEVER expose to frontend)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
# Server-only: HS256 secret required in production for verifying Supabase JWTs
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# ---------------------------------------------------------------------
# Shopify Partner App Credentials (Required for Shopify OAuth & Webhooks)
# ---------------------------------------------------------------------
SHOPIFY_API_KEY=your_shopify_api_key_here
SHOPIFY_API_SECRET=your_shopify_api_secret_here

# ---------------------------------------------------------------------
# Stripe Monetization (Required in production for subscriptions & webhooks)
# ---------------------------------------------------------------------
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here
STRIPE_PRICE_STARTER=price_starter_monthly
STRIPE_PRICE_GROWTH=price_growth_monthly
STRIPE_PRICE_AGENCY=price_agency_monthly
STRIPE_PRICE_ENTERPRISE=price_enterprise_monthly

# ---------------------------------------------------------------------
# Failover Worker Correlation & Incident Retry Policy (Phase 4 Step 5)
# ---------------------------------------------------------------------
FAILOVER_ALLOW_DELAYED_RETRY=true
FAILOVER_CORRELATION_MAX_RETRIES=3

# ---------------------------------------------------------------------
# Frontend Client Configuration (Next.js - http://localhost:3000)
# Note: Inlined into the browser bundle at build time
# ---------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
