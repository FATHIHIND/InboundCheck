# =====================================================================
# InboundCheck Frontend Environment Variables
# Local Development Port: http://localhost:3000
# NOTE: All NEXT_PUBLIC_* variables are inlined into the browser client
# bundle at build time. NEVER place server secrets or private keys here.
# =====================================================================

# Supabase Public Configuration (Anon key is designed to be public & RLS-governed)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Backend FastAPI Server Endpoint
NEXT_PUBLIC_API_URL=http://localhost:8000

# Canonical Site URL (Used for OAuth redirects & canonical metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
