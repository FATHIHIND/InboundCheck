# Public build-time configuration only. No service-role keys or backend secrets here.
# Copy this template locally and supply your own non-production project values.
NEXT_PUBLIC_SUPABASE_URL=https://example-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-public-anon-key
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Vercel exposes VERCEL_ENV server-side; the public value is optional outside Vercel.
NEXT_PUBLIC_VERCEL_ENV=development
# Framework/runtime controls (not secrets)
NODE_ENV=development
NEXT_TELEMETRY_DISABLED=1
