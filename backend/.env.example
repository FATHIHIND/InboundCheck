# Example only. Never copy production/staging secrets into source control.
# Use distinct secret-store configuration for each deployment. Set ENVIRONMENT=staging
# or production there, with exact ALLOWED_HOSTS, FRONTEND_URL and CORS_ORIGINS.
# Provision ENCRYPTION_KEY explicitly in each non-local environment. Preserve existing
# keys/ciphertexts; changing keys requires an approved rotation/re-encryption plan.
# Set server Stripe price IDs and provider settings explicitly before enabling them.
# Blank credential values are intentional: the deployed services must fail closed.
PROJECT_NAME=InboundCheck API
API_V1_STR=/api/v1
ENVIRONMENT=development
STAGING_MODE=false
FRONTEND_URL=http://localhost:3000
ALLOWED_HOSTS=["localhost","127.0.0.1"]
CORS_ORIGINS=["http://localhost:3000"]
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated
OPS_INTERNAL_API_KEY=
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_AGENCY=
STRIPE_PRICE_ENTERPRISE=
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL_NAME=
AGENT_ROUTER_API_BASE=
AGENT_ROUTER_API_KEY=
AGENT_ROUTER_MODEL_NAME=
AGENT_ROUTER_TIMEOUT_SECONDS=10
AGENT_ROUTER_MAX_TOKENS=4000
AGENT_ROUTER_TEMPERATURE=0.7
AGENT_ROUTER_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
OPS_ALERT_WEBHOOK_URL=
OPS_ALERT_TELEGRAM_BOT_TOKEN=
OPS_ALERT_TELEGRAM_CHAT_ID=
CLOUDFLARE_API_TOKEN=
GODADDY_API_KEY=
GODADDY_API_SECRET=
ENCRYPTION_KEY=
RUN_IN_PROCESS_SCHEDULER=false
FAILOVER_ALLOW_DELAYED_RETRY=false
FAILOVER_CORRELATION_MAX_RETRIES=3
POSTMARK_WEBHOOK_SECRET=
SENDGRID_WEBHOOK_VERIFICATION_KEY=
MAILGUN_WEBHOOK_SIGNING_KEY=
SES_WEBHOOK_SECRET=
KLAVIYO_WEBHOOK_SECRET=
ASSET_FETCH_HTTPS_ONLY=true
ASSET_FETCH_PORT=443
ASSET_FETCH_TIMEOUT_SECONDS=4
ASSET_FETCH_MAX_BYTES=512000
ASSET_FETCH_MAX_REDIRECTS=3
ASSET_FETCH_TRUST_ENV=false
