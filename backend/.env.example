# =====================================================================
# InboundCheck Backend Environment Variables
# Local Development Port: http://localhost:8000
# =====================================================================

PROJECT_NAME="InboundCheck API Engine"
ENVIRONMENT="development"
API_V1_STR="/api/v1"
FRONTEND_URL="http://localhost:3000"

# CORS Origins (JSON list or comma-separated)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Supabase Credentials (Required for persistence and authentication)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
# Production-only requirement: Symmetric HMAC (HS256) secret for cryptographically verifying Supabase user JWTs
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# Shopify Partner App Credentials (Required for Shopify OAuth & Webhooks)
SHOPIFY_API_KEY=your_shopify_api_key_here
SHOPIFY_API_SECRET=your_shopify_api_secret_here

# Stripe Credentials (Required in production for subscriptions & webhooks)
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here
STRIPE_PRICE_STARTER=price_starter_monthly
STRIPE_PRICE_GROWTH=price_growth_monthly
STRIPE_PRICE_AGENCY=price_agency_monthly
STRIPE_PRICE_ENTERPRISE=price_enterprise_monthly

# Optional: Open-Weights Deliverability Intelligence LLM Adapter
LLM_API_BASE=https://api.moonshot.cn/v1
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL_NAME=moonshot-v1-8k

# Optional: Agent Router Configuration
AGENT_ROUTER_API_BASE=https://openrouter.ai/api/v1
AGENT_ROUTER_API_KEY=your_openrouter_api_key_here
AGENT_ROUTER_MODEL_NAME=google/gemma-4-26b-a4b-it
AGENT_ROUTER_TIMEOUT_SECONDS=15
AGENT_ROUTER_MAX_TOKENS=2048
AGENT_ROUTER_TEMPERATURE=0.7
AGENT_ROUTER_ENABLED=false

# Optional: Automated 1-Click DNS Auto-Fix Providers (Cloudflare & GoDaddy)
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
GODADDY_API_KEY=your_godaddy_api_key_here
GODADDY_API_SECRET=your_godaddy_api_secret_here
ENCRYPTION_KEY=your_fernet_credential_encryption_key_here

# Optional: ESP Delivery Failure Webhook Verification Keys
POSTMARK_WEBHOOK_SECRET=your_postmark_webhook_secret_here
SENDGRID_WEBHOOK_VERIFICATION_KEY=your_sendgrid_webhook_key_here
MAILGUN_WEBHOOK_SIGNING_KEY=your_mailgun_signing_key_here
SES_WEBHOOK_SECRET=your_ses_webhook_secret_here
KLAVIYO_WEBHOOK_SECRET=your_klaviyo_webhook_secret_here

# Optional: Operational Incident Alerting (OpsAlertService & Telegram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
OPS_ALERT_WEBHOOK_URL=your_incident_webhook_url_here